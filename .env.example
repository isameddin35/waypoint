# Database
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/waypoint
SPRING_DATASOURCE_USERNAME=waypoint
SPRING_DATASOURCE_PASSWORD=waypoint

# JWT
JWT_SECRET=WaypointSecretKeyForJWTTokenGeneration2024MustBe256BitsLongMin
JWT_ACCESS_TOKEN_EXPIRATION_MS=1800000
JWT_REFRESH_TOKEN_EXPIRATION_MS=604800000

# PostgreSQL (for docker-compose)
POSTGRES_DB=waypoint
POSTGRES_USER=waypoint
POSTGRES_PASSWORD=waypoint
